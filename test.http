### --- PRODUCTOS (DETAILS) ---

# @name get_all_products
GET {{baseUrl}}/products
Content-Type: application/json

###

# @name create_product
POST {{baseUrl}}/products
Content-Type: application/json

{
    "commercial_name": "Amoxicilina Genfar",
    "generic_name": "Amoxicilina",
    "id_family": 1,
    "action_mechanism": "Inhibe la síntesis de la pared celular bacteriana",
    "id_laboratory": 1,
    "concentration": "500mg",
    "id_pharmaceutical_form": 1,
    "id_posology": 1,
    "notes": "No usar en alérgicos a la penicilina",
    "is_active": true
}

###

# @name update_product
PUT {{baseUrl}}/products/1
Content-Type: application/json

{
    "commercial_name": "Amoxicilina Genfar Forte",
    "concentration": "750mg"
}

###

# @name delete_product
DELETE {{baseUrl}}/products/169
Content-Type: application/json
