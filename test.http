@baseUrl = http://localhost:5001/api

### --- AUTENTICACIÓN ---

# @name create_user
POST {{baseUrl}}/auth/create
Content-Type: application/json

{
    "identification": "12345678",
    "password": "12345678",
    "full_name": "Usuario de Prueba"
}

###

# @name login_user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "identification": "12345678",
    "password": "mi-password-seguro"
}

### --- GRUPOS TERAPÉUTICOS ---

# @name get_all_therapeutic_groups
GET {{baseUrl}}/therapeutic-groups
Content-Type: application/json

###

# @name create_therapeutic_group
POST {{baseUrl}}/therapeutic-groups
Content-Type: application/json

{
    "name": "Antibióticos"
}

###

# @name get_therapeutic_group_by_id
GET {{baseUrl}}/therapeutic-groups/1
Content-Type: application/json

###

# @name update_therapeutic_group
PUT {{baseUrl}}/therapeutic-groups/1
Content-Type: application/json

{
    "name": "Antibióticos Actualizado"
}

###

# @name delete_therapeutic_group
DELETE {{baseUrl}}/therapeutic-groups/8
Content-Type: application/json


### --- FAMILIAS ---

